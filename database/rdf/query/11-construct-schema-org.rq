# CONSTRUCT: susun ulang data museum menjadi graf schema.org murni, misalnya untuk JSON-LD di halaman web.
PREFIX mv: <https://medanvisit.neoverse.my.id/ontologi#>
PREFIX res: <https://medanvisit.neoverse.my.id/id/>
PREFIX schema: <https://schema.org/>
PREFIX geo: <http://www.w3.org/2003/01/geo/wgs84_pos#>

CONSTRUCT {
  ?t a schema:Museum ; schema:name ?nama ; schema:latitude ?lat ; schema:longitude ?long .
} WHERE {
  ?t a mv:Museum ; schema:name ?nama ; geo:lat ?lat ; geo:long ?long .
}
