# Linked data: tempat yang ditautkan ke Wikidata lewat owl:sameAs.
PREFIX mv: <https://medanvisit.neoverse.my.id/ontologi#>
PREFIX res: <https://medanvisit.neoverse.my.id/id/>
PREFIX schema: <https://schema.org/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX wd: <http://www.wikidata.org/entity/>

SELECT ?tempat ?wikidata WHERE {
  ?t a mv:TempatWisata ; schema:name ?tempat ; owl:sameAs ?wikidata .
  FILTER (STRSTARTS(STR(?wikidata), STR(wd:)))
}
ORDER BY ?tempat
