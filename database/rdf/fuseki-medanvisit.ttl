# Konfigurasi Apache Jena Fuseki untuk dataset MedanVisit.
# Jalankan dari folder Fuseki:  fuseki-server --config=<path ke file ini>
# Endpoint SPARQL: http://localhost:3030/medanvisit/sparql (hanya baca; data sumber disimpan sebagai Turtle).
#
# Ontologi dan data dimuat ulang dari file setiap Fuseki dinyalakan, jadi selalu sama dengan isi repo.
# Reasoner OWL Micro menurunkan fakta dari ontologi: kelas induk (setiap mv:Museum juga mv:TempatWisata
# dan schema:Museum), properti kebalikan (mv:membangun dari mv:dibangunOleh), simetris, dan transitif.

PREFIX :        <#>
PREFIX fuseki:  <http://jena.apache.org/fuseki#>
PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX ja:      <http://jena.hpl.hp.com/2005/11/Assembler#>

[] rdf:type fuseki:Server ;
    fuseki:services ( :layanan ) .

:layanan rdf:type fuseki:Service ;
    fuseki:name "medanvisit" ;
    fuseki:endpoint [ fuseki:operation fuseki:query ; fuseki:name "sparql" ] ;
    fuseki:endpoint [ fuseki:operation fuseki:query ] ;
    fuseki:endpoint [ fuseki:operation fuseki:gsp-r ; fuseki:name "get" ] ;
    fuseki:dataset :dataset .

:dataset rdf:type ja:RDFDataset ;
    ja:defaultGraph :model_inferensi .

:model_inferensi rdf:type ja:InfModel ;
    ja:baseModel :model_dasar ;
    ja:reasoner [ ja:reasonerURL <http://jena.hpl.hp.com/2003/OWLMicroFBRuleReasoner> ] .

# path relatif terhadap lokasi file konfigurasi ini
:model_dasar rdf:type ja:MemoryModel ;
    ja:content [ ja:externalContent <medanvisit-ontologi.ttl> ] ;
    ja:content [ ja:externalContent <medanvisit-data.ttl> ] .
