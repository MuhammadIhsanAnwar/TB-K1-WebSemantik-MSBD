# ---------- jalur tematik ----------

res:jejak-kesultanan-deli a mv:JalurTematik ;
    schema:name "Jejak Kesultanan Deli"@id ;
    schema:description "Istana, meriam, masjid, dan taman yang dibangun di masa Sultan Ma'moen Al Rasyid."@id ;
    schema:image <https://medanvisit.neoverse.my.id/images/foto/istana-maimun-1900.jpg> ;
    mv:persinggahan res:jejak-kesultanan-deli-singgah-1 ;
    mv:persinggahan res:jejak-kesultanan-deli-singgah-2 ;
    mv:persinggahan res:jejak-kesultanan-deli-singgah-3 ;
    mv:persinggahan res:jejak-kesultanan-deli-singgah-4 .

res:jejak-kesultanan-deli-singgah-1 a mv:Persinggahan ;
    mv:urutan "1"^^xsd:positiveInteger ;
    mv:tempatSinggah res:istana-maimun .

res:jejak-kesultanan-deli-singgah-2 a mv:Persinggahan ;
    mv:urutan "2"^^xsd:positiveInteger ;
    mv:tempatSinggah res:meriam-puntung .

