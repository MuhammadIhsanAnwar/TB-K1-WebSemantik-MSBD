# ---------- tempat wisata ----------

res:istana-maimun a mv:SitusSejarah ;
    rdfs:label "Istana Maimun"@id ;
    schema:name "Istana Maimun"@id ;
    schema:description "Istana Kesultanan Deli, dibangun 1888–1891 oleh Sultan Ma'moen Al Rasyid."@id ;
    mv:cerita "Istana Maimun dibangun Sultan Ma'moen Al Rasyid Perkasa Alamsyah, sultan Deli kesembilan, dan rampung pada 1891. Bangunannya memadukan unsur Melayu, Islam, India, dan Eropa.\n\nWarna kuning yang mendominasi istana adalah warna kebesaran Melayu. Sampai sekarang sebagian ruangan masih ditinggali kerabat kesultanan, dan pengunjung bisa berfoto memakai baju adat Melayu di balairung.\n\nDi halaman istana ada bangunan kecil yang menyimpan Meriam Puntung, yang dalam cerita rakyat dikaitkan dengan legenda Putri Hijau."@id ;
    schema:address [ a schema:PostalAddress ; schema:streetAddress "Jl. Brigjend Katamso No. 66" ; schema:addressLocality "Medan" ; schema:addressRegion "Sumatera Utara" ; schema:addressCountry "ID" ] ;
    geo:lat "3.57529"^^xsd:decimal ;
    geo:long "98.68405"^^xsd:decimal ;
    mv:koordinatPerkiraan false ;
    mv:keteranganJam "Setiap hari, 08.00–17.00" ;
    mv:jamContoh true ;
    mv:radiusCheckin 150 ;
    mv:durasiSinggah 60 ;
    schema:isAccessibleForFree false ;
    mv:kelurahan "Aur" ;
    mv:jamBuka "08:00:00"^^xsd:time ;
    mv:jamTutup "17:00:00"^^xsd:time ;
    mv:fasilitas "Parkir"@id ;
    mv:fasilitas "Toilet"@id ;
    mv:fasilitas "Mushola"@id ;
    mv:fasilitas "Sewa baju adat Melayu (Rp20.000–50.000)"@id ;
    mv:fasilitas "Balita di bawah 5 tahun gratis"@id ;
    mv:caraMenuju "Becak motor dari Kesawan, tawar ongkos sebelum naik (sekitar Rp20.000–30.000)"@id ;
    mv:caraMenuju "Bus Listrik Medan koridor K1 melintas di depan istana"@id ;
    mv:caraMenuju "Jalan kaki dari Masjid Raya Al-Mashun, sekitar 6 menit"@id ;
    schema:image <https://medanvisit.neoverse.my.id/images/foto/istana-maimun.jpg> ;
    owl:sameAs wd:Q1674833 ;
    mv:hargaTiketMulai 5000 ;
    mv:hargaContoh true ;
    schema:offers [ a schema:Offer ; schema:name "Dewasa"@id ; schema:price 10000 ; schema:priceCurrency "IDR" ] ;
    schema:offers [ a schema:Offer ; schema:name "Anak"@id ; schema:price 5000 ; schema:priceCurrency "IDR" ] .

res:masjid-raya-al-mashun a mv:RumahIbadah ;
    rdfs:label "Masjid Raya Al-Mashun"@id ;
    schema:name "Masjid Raya Al-Mashun"@id ;
    schema:description "Masjid Kesultanan Deli, dibangun 1906–1909 dengan denah segi delapan."@id ;
    mv:cerita "Masjid Raya Al-Mashun dibangun oleh Sultan Ma'moen Al Rasyid, sultan yang sama yang membangun Istana Maimun, dan selesai pada 1909.\n\nDenahnya segi delapan dengan kubah utama dikelilingi empat serambi. Masjid ini masih dipakai untuk salat berjamaah, jadi pengunjung datang di luar waktu salat dan berpakaian sopan."@id ;
    schema:address [ a schema:PostalAddress ; schema:streetAddress "Jl. Sisingamangaraja" ; schema:addressLocality "Medan" ; schema:addressRegion "Sumatera Utara" ; schema:addressCountry "ID" ] ;
    geo:lat "3.57517"^^xsd:decimal ;
    geo:long "98.6873"^^xsd:decimal ;
    mv:koordinatPerkiraan false ;
    mv:keteranganJam "Terbuka di luar waktu salat" ;
    mv:jamContoh true ;
    mv:radiusCheckin 100 ;
    mv:durasiSinggah 45 ;
    schema:isAccessibleForFree true ;
    mv:kelurahan "Mesjid" ;
    mv:jamBuka "05:00:00"^^xsd:time ;
    mv:jamTutup "21:00:00"^^xsd:time ;
    mv:fasilitas "Parkir"@id ;
    mv:fasilitas "Tempat wudu"@id ;
    mv:fasilitas "Peminjaman kain penutup"@id ;
    mv:caraMenuju "Jalan kaki dari Istana Maimun, sekitar 6 menit"@id ;
    schema:image <https://medanvisit.neoverse.my.id/images/foto/masjid-raya.jpg> ;
    owl:sameAs wd:Q12497331 .

res:tjong-a-fie-mansion a mv:SitusSejarah ;
    rdfs:label "Tjong A Fie Mansion"@id ;
    schema:name "Tjong A Fie Mansion"@id ;
    schema:description "Rumah saudagar Tjong A Fie di Kesawan, kini museum rumah."@id ;
    mv:cerita "Tjong A Fie adalah saudagar Hakka yang datang ke Deli pada masa kejayaan tembakau dan menjadi pemimpin komunitas Tionghoa Medan. Rumahnya di Kesawan selesai dibangun sekitar 1900.\n\nArsitekturnya memadukan rumah Tionghoa, Eropa, dan Melayu. Kamar, perabot, dan foto keluarga masih tersimpan, sehingga pengunjung bisa melihat bagaimana sebuah keluarga saudagar hidup di Medan awal abad ke-20."@id ;
    schema:address [ a schema:PostalAddress ; schema:streetAddress "Jl. Jend. Ahmad Yani No. 105" ; schema:addressLocality "Medan" ; schema:addressRegion "Sumatera Utara" ; schema:addressCountry "ID" ] ;
    geo:lat "3.58543"^^xsd:decimal ;
    geo:long "98.68037"^^xsd:decimal ;
    mv:koordinatPerkiraan false ;
    mv:keteranganJam "Setiap hari, 09.00–17.00 (masuk terakhir 16.30), tutup saat Imlek" ;
    mv:jamContoh false ;
    mv:radiusCheckin 80 ;
    mv:durasiSinggah 60 ;
    schema:isAccessibleForFree false ;
    mv:kelurahan "Kesawan" ;
    mv:jamBuka "09:00:00"^^xsd:time ;
    mv:jamTutup "17:00:00"^^xsd:time ;
    mv:fasilitas "Pemandu"@id ;
    mv:fasilitas "Toilet"@id ;
    mv:fasilitas "Kafe"@id ;
    mv:caraMenuju "Jalan kaki dari Lapangan Merdeka, sekitar 8 menit"@id ;
    mv:caraMenuju "Becak motor dari Istana Maimun, sekitar 10 menit"@id ;
    schema:image <https://medanvisit.neoverse.my.id/images/foto/tjong-a-fie-mansion.jpg> ;
    owl:sameAs wd:Q7810631 ;
    mv:hargaTiketMulai 35000 ;
    mv:hargaContoh false ;
    schema:offers [ a schema:Offer ; schema:name "Umum, termasuk pemandu"@id ; schema:price 35000 ; schema:priceCurrency "IDR" ] .

res:meriam-puntung a mv:SitusSejarah ;
    rdfs:label "Meriam Puntung"@id ;
    schema:name "Meriam Puntung"@id ;
    schema:description "Meriam di halaman Istana Maimun yang dikaitkan dengan legenda Putri Hijau."@id ;
    mv:cerita "Menurut cerita rakyat, meriam ini adalah penjelmaan saudara Putri Hijau yang menembak tanpa henti saat kerajaan diserang hingga patah. Satu potongannya ada di Istana Maimun, potongan lainnya di Tanah Karo."@id ;
    schema:address [ a schema:PostalAddress ; schema:streetAddress "Kompleks Istana Maimun" ; schema:addressLocality "Medan" ; schema:addressRegion "Sumatera Utara" ; schema:addressCountry "ID" ] ;
    geo:lat "3.57493"^^xsd:decimal ;
    geo:long "98.68405"^^xsd:decimal ;
    mv:koordinatPerkiraan false ;
    mv:keteranganJam "Mengikuti jam buka Istana Maimun" ;
    mv:jamContoh true ;
    mv:radiusCheckin 60 ;
    mv:durasiSinggah 15 ;
    schema:isAccessibleForFree true ;
    mv:kelurahan "Aur" ;
    mv:jamBuka "08:00:00"^^xsd:time ;
    mv:jamTutup "17:00:00"^^xsd:time ;
    mv:caraMenuju "Di halaman Istana Maimun"@id ;
    schema:image <https://medanvisit.neoverse.my.id/images/foto/meriam-puntung.jpg> .

res:kuil-shri-mariamman a mv:RumahIbadah ;
    rdfs:label "Kuil Shri Mariamman"@id ;
    schema:name "Kuil Shri Mariamman"@id ;
    schema:description "Kuil Hindu tertua di Medan, berdiri sejak 1884 di Kampung Madras."@id ;
    mv:cerita "Kuil ini dibangun komunitas Tamil pada 1884 dan menjadi pusat Kampung Madras, kawasan yang juga dikenal sebagai Little India Medan. Menara gerbangnya dipenuhi patung dewa berwarna cerah."@id ;
