            "schema:description": {
                "@language": "id",
                "@value": "Masjid Kesultanan Deli, dibangun 1906–1909 dengan denah segi delapan."
            },
            "mv:cerita": {
                "@language": "id",
                "@value": "Masjid Raya Al-Mashun dibangun oleh Sultan Ma'moen Al Rasyid, sultan yang sama yang membangun Istana Maimun, dan selesai pada 1909.\n\nDenahnya segi delapan dengan kubah utama dikelilingi empat serambi. Masjid ini masih dipakai untuk salat berjamaah, jadi pengunjung datang di luar waktu salat dan berpakaian sopan."
            },
